{
    "name":  "browser-use",
    "version":  "0.3.6",
    "type":  "module",
    "private":  true,
    "description":  "Reusable local browser automation runtime for AI agents.",
    "main":  "desktop/main.cjs",
    "bin":  {
                "browser-use":  "cli/browser-use.js",
                "browser":  "cli/browser-use.js",
                "lorde":  "cli/browser-use.js"
            },
    "scripts":  {
                    "install-cli":  "npm link",
                    "start":  "node src/index.js",
                    "dev":  "node src/index.js",
                    "smoke":  "node src/index.js --smoke",
                    "replay":  "node src/replay.js",
                    "test:production":  "node tests/production-e2e.mjs",
                    "test:mcp":  "node tests/mcp-e2e.mjs",
                    "test:mcp:http":  "node tests/mcp-http-e2e.mjs",
                    "mcp:http":  "node src/index.js --mcp-http",
                    "upstream:mcp":  "node scripts/run-upstream-browser-use.mjs",
                    "upstream:cli-mcp":  "node scripts/run-upstream-browser-use.mjs --cli-mcp",
                    "upstream:sync":  "git -C .upstream-browser-use fetch origin main \u0026\u0026 git -C .upstream-browser-use checkout --detach origin/main",
                    "reference:mcp":  "node scripts/run-reference-browser-use.mjs",
                    "reference:cli-mcp":  "node scripts/run-reference-browser-use.mjs --cli-mcp",
                    "test:upstream":  "node --test tests/upstream-runtime.test.mjs",
                    "test:upstream:mcp":  "node tests/upstream-mcp-e2e.mjs",
                    "test:reference:mcp":  "node tests/reference-mcp-e2e.mjs",
                    "test:mcp:electron":  "node tests/mcp-electron-runtime-e2e.mjs",
                    "test:mcp:packaged":  "node tests/mcp-packaged-runtime-e2e.mjs",
                    "test:headed-loop":  "node tests/headed-benchmark-loop.mjs",
                    "test:agent-cursor":  "node tests/agent-cursor-e2e.mjs",
                    "test:desktop:cursor":  "node tests/agent-cursor-tracking-e2e.mjs",
                    "test:desktop:pointer":  "node --test tests/agent-pointer-controller.test.mjs tests/agent-pointer-overlay.test.mjs \u0026\u0026 node tests/agent-pointer-overlay-e2e.mjs",
                    "test:desktop:cursor:packaged":  "node tests/agent-cursor-tracking-e2e.mjs desktop-release/win-unpacked",
                    "test":  "npm run test:production \u0026\u0026 npm run test:mcp \u0026\u0026 npm run test:agent-cursor \u0026\u0026 npm run test:headed-loop",
                    "build":  "node scripts/build.js",
                    "desktop:dev":  "electron .",
                    "test:desktop":  "node tests/desktop-interaction-e2e.mjs",
                    "test:desktop:background":  "node tests/desktop-background-e2e.mjs",
                    "test:computer":  "node --test tests/computer-tools.test.mjs",
                    "test:computer:e2e":  "node tests/computer-tools-e2e.mjs",
                    "test:desktop:units":  "node --test tests/agent-pointer-controller.test.mjs tests/agent-pointer-overlay.test.mjs tests/desktop-mcp-session.test.mjs tests/desktop-mcp-bootstrap.test.mjs tests/desktop-input-release.test.mjs tests/desktop-package-contract.test.mjs tests/desktop-capture-timeout.test.mjs tests/desktop-ai-chat-agent.test.mjs tests/desktop-thinking-stream.test.mjs tests/desktop-ollama-provider.test.mjs tests/desktop-cloud-provider.test.mjs tests/desktop-openai-compatible-provider.test.mjs tests/agent-pool.test.mjs",
                    "test:desktop:input":  "node tests/desktop-paired-input-e2e.mjs",
                    "test:desktop:packaged":  "node tests/desktop-packaged-app-e2e.mjs",
                    "test:desktop:capture":  "node tests/desktop-capture-drawer-e2e.mjs",
                    "test:desktop:crop":  "node tests/desktop-startup-crop-e2e.mjs",
                    "test:desktop:view-leak":  "node tests/desktop-view-listener-leak-e2e.mjs",
                    "desktop:package":  "electron-builder --config electron-builder.yml --win dir nsis portable \u0026\u0026 node scripts/verify-desktop-artifacts.mjs \u0026\u0026 node scripts/verify-desktop-fixes.mjs",
                    "prepare":  "npm link"
                },
    "dependencies":  {
                         "@xterm/addon-fit":  "^0.10.0",
                         "@xterm/xterm":  "^5.5.0",
                         "browser-use-sdk":  "^3.10.0",
                         "chrome-remote-interface":  "^0.33.3",
                         "ink":  "7.0.3",
                         "ink-spinner":  "5.0.0",
                         "koffi":  "3.2.1",
                         "mediabunny":  "^1.60.0",
                         "node-pty":  "^1.1.0",
                         "playwright-core":  "^1.62.1",
                         "react":  "19.2.0",
                         "ws":  "^8.18.0"
                     },
    "devDependencies":  {
                            "braintrust":  "3.32.0",
                            "electron":  "^43.2.0",
                            "electron-builder":  "^26.15.3",
                            "ink-testing-library":  "4.0.0",
                            "postject":  "^1.0.0-alpha.6"
                        }
}
